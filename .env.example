# Use the local deterministic workflow by default. Set to `api` for the real backend.
VITE_APP_MODE=fixture

# Leave empty to use the Vite dev proxy in API mode.
# The proxy currently forwards /api to http://127.0.0.1:8000.
#
# Set this only when the backend is directly reachable from the browser,
# for example when calling a remote CIP API without the Vite proxy:
# VITE_BACKEND_API_URL=http://<cip-hostname>:8000
VITE_BACKEND_API_URL=
